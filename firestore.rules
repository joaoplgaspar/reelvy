rules_version = '2';

// Regras da Fase 0 — ver docs/ARQUITETURA-FASE-0.md §8.
// As Functions usam o Admin SDK e IGNORAM estas regras, por isso o catálogo é `write: false`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo cacheado: leitura p/ autenticados; escrita só via Functions.
    match /media_meta/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /discovery_lists/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Dados pessoais: só o dono.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Biblioteca em subcoleção (1 doc por título) — NUNCA array no doc do user.
      match /library/{mediaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Sessões de match (dois+ celulares em tempo real). O sid (código) é o "segredo".
    match /sessions/{sid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.host;
      // membro atual pode atualizar; ou quem está entrando (se adiciona aos members).
      allow update: if request.auth != null &&
                       (request.auth.uid in resource.data.members ||
                        request.auth.uid in request.resource.data.members);
      allow delete: if false;

      // votos: cada um escreve só o seu; todos os membros leem (p/ detectar o match).
      match /votes/{voteUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == voteUid;
      }
    }
  }
}
