# Firebase Web SDK — Console do Firebase → Project settings → Seus apps → Config.
# Copie este arquivo para `.env` (gitignored) e preencha. Sem isso, o app roda no estado local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
